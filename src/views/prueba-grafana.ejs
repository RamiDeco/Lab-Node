
<!-- Este es un panel de control solo para testear la grafica y otras funcionalidades, todavia falta hacer el resto del frontend.-->

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Laboratorio Remoto v1.0</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Roboto+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/style-grafana.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body data-userid="<%= locals.user ? (locals.user.userId || locals.user.id) : '' %>">
    <header>
        <div class="conteiner-name_user">
            <h2 style="color: white; margin-bottom: 15px;">
                Bienvenido, 
                <% if (user && user.name) { %>
                    <span style="color: #4facfe;"><%= user.name %></span>
                <% } else { %>
                    <span style="color: orange;">(Sin nombre)</span>
                <% } %>
            </h2>
        </div>
        <div class="container-title">
            <h1> Panel de Control </h1>
            <div id="socketStatus" style="color: var(--text-muted);">Conectando...</div>
        </div>
        
        <div class="login-form__actions" style="margin-top: 20px;">
            <button id="btnLogout" class="login-form__button" style="background-color: #ff4757;">
                Cerrar Sesión
            </button>
        </div>
    </header>

    <div class="main-container">
        <div id="dashboard-section">
            <div class="left-col">

            <div class="card">
                <label style="color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase; font-weight: 600;">Sensor Térmico</label>
                <div class="digital-display" id="tempDisplay">--.-- °C</div>
            </div>

            <div class="card" style="margin-top: 20px;">
                <button id="crearTurnoBtn">Solicitar Turno</button>
                <div id="turnStatus" style="margin-top: 15px; font-size: 0.9rem; color: var(--text-muted);">Estado: Inactivo</div>
                <button id="startExp">INICIAR EXPERIMENTO</button>

                <!-- Este boton es de testeo luego hay que eliminarlo -->
                <hr style="border-color: #333; margin: 20px 0;">
                <button id="resetQueueBtn" style="background-color: #ff4757; color: white;">Resetear </button>

            </div>
        </div>

            <div class="right-col">
                <div class="card" style="box-sizing: border-box; padding: 1rem;">
                    <div class="grafana-container" style="position: relative; width: 100%; height: 400px; overflow: hidden;">
                        <iframe 
                            src="http://localhost:3001/d-solo/adc7682/grafana-lab?orgId=1&from=1771611225939&to=1771611525939&timezone=browser&refresh=5s&panelId=1&kiosk" 
                            width="100%" 
                            height="100%" 
                            frameborder="0">
                        </iframe>
                    
                        <div style="position: absolute; top: 0; right: 0; width: 45px; height: 40px; background-color: #111217; z-index: 10; cursor: default;"></div>
                    
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

<script src="http://localhost:3000/socket.io/socket.io.js"></script>
<script src="js/main-grafana.js"></script>
<script>
    document.getElementById('btnLogout').addEventListener('click', async () => {
    try {
        // Llamamos al backend para que borre la cookie
        const response = await fetch('/auth/logout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });

        if (response.ok) {
            // Una vez borrada la cookie, redirigimos al login
            window.location.href = '/login';
        }
    } catch (error) {
        console.error('Error al cerrar sesión:', error);
    }
});
</script>

</html>